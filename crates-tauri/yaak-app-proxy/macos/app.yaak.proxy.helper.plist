<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <!-- Registered by the app with SMAppService.daemon(plistName:), approved once in
             System Settings > General > Login Items & Extensions. -->
        <key>Label</key>
        <string>app.yaak.proxy.helper</string>
        <key>BundleProgram</key>
        <string>Contents/MacOS/yaak-proxy-helper</string>
        <key>AssociatedBundleIdentifiers</key>
        <array>
            <string>app.yaak.proxy</string>
            <string>app.yaak.proxy.dev</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <!-- Restarted after a crash, not after a clean exit (unregistered, or stopped). -->
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
        <key>StandardErrorPath</key>
        <string>/Library/Logs/app.yaak.proxy.helper.log</string>
    </dict>
</plist>
